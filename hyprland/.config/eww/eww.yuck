;; power buttons
(defwidget logout [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_logout" :onclick "openbox --exit" "󰗽")))
(defwidget sleep [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_sleep" :onclick "systemctl suspend" "󰤄")))
(defwidget reboot [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_reboot" :onclick "systemctl reboot" "󰓦")))
(defwidget poweroff [] 
	(box :class "genwin" :vexpand "false" :hexpand "false" 
		(button :class "btn_poweroff" :onclick "systemctl poweroff" "󰐥")))


;; logout
(defwindow logout :monitor 1 :stacking "fg" :focusable "false" :screen 1 
	    :geometry (geometry :x 0 :y 0 :width 50 :height 50)
					(logout))

;; sleep
(defwindow sleep :monitor 1 :stacking "fg" :focusable "false" :screen 1 
	    :geometry (geometry :x 0 :y 0 :width 50 :height 50)
					(sleep))

;; reboot
(defwindow reboot :monitor 1 :stacking "fg" :focusable "false" :screen 1 
	    :geometry (geometry :x 0 :y 0 :width 50 :height 50)
					(reboot))

;; poweroff
(defwindow poweroff :monitor 1 :stacking "fg" :focusable "false" :screen 1 
	    :geometry (geometry :x 0 :y 50 :width 50 :height 50)
					(poweroff))
